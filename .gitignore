.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Logs and scratch files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
